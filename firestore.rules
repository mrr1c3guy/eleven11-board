rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the signed-in team account (team password) can read or write.
    match /{col}/{doc} {
      allow read, write: if request.auth != null
        && col in ['songs', 'comments', 'todos', 'demopicks', 'chat', 'audio'];
    }
  }
}
